# Copy to .env.local and fill in. Never commit .env.local.
# Only NEXT_PUBLIC_* vars reach the browser.

APP_URL=http://localhost:3000

# Phase 1 — Supabase (supabase.com → project → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Phase 3 — AI (anthropic | mock)
AI_PROVIDER=mock
ANTHROPIC_API_KEY=

# Phase 4 — PayPal sandbox (developer.paypal.com → Apps & Credentials → Sandbox)
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_WEBHOOK_ID=

# Phase 5/6 — scheduled jobs (random string, 32+ chars)
JOBS_SECRET=

# Phase 7 — enables "Demo: skip 3 days" and judge demo logins
DEMO_MODE=false
